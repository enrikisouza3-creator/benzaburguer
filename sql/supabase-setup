-- ============================================================
--  RLS -- SEM ISSO, com Row Level Security ativado (padrao do
--  Supabase para tabelas novas), TODO insert/select da anon key
--  falha com 401/403 e o pedido nunca chega ao banco.
--  Isso e o motivo mais provavel do "pedido nao salva".
-- ============================================================
alter table pedidos enable row level security;
alter table itens_pedido enable row level security;
alter table bairros_entrega enable row level security;
alter table cupons enable row level security;
alter table cardapio_disponibilidade enable row level security;
alter table clientes enable row level security;

-- pedidos: o site publico so cria e le, nunca atualiza/apaga
create policy "pedidos_insert_publico" on pedidos
  for insert to anon with check (true);
create policy "pedidos_select_publico" on pedidos
  for select to anon using (true);
-- painel admin (mesma anon key hoje) precisa atualizar status
create policy "pedidos_update_publico" on pedidos
  for update to anon using (true) with check (true);

create policy "itens_pedido_insert_publico" on itens_pedido
  for insert to anon with check (true);
create policy "itens_pedido_select_publico" on itens_pedido
  for select to anon using (true);

create policy "bairros_select_publico" on bairros_entrega
  for select to anon using (true);
create policy "bairros_crud_admin" on bairros_entrega
  for all to anon using (true) with check (true);

create policy "cupons_select_publico" on cupons
  for select to anon using (true);

create policy "cardapio_disp_select_publico" on cardapio_disponibilidade
  for select to anon using (true);
create policy "cardapio_disp_crud_admin" on cardapio_disponibilidade
  for all to anon using (true) with check (true);

create policy "clientes_insert_publico" on clientes
  for insert to anon with check (true);
create policy "clientes_select_publico" on clientes
  for select to anon using (true);

-- ATENCAO: essas policies liberam leitura/escrita para qualquer
-- portador da anon key (que fica exposta no HTML). Isso inclui
-- o painel admin, que hoje so tem uma senha fixa no client-side
-- (facilmente lida no DevTools). Para producao real, o admin
-- deveria autenticar via Supabase Auth e as policies de UPDATE/
-- DELETE deveriam checar auth.role() = 'authenticated', nao
-- ficar abertas para 'anon'.
